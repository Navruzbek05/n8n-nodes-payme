{
    "name": "n8n-nodes-payme",
    "version": "0.2.0",
    "description": "n8n community node for Payme Business (Uzbekistan): payment links, receipts and merchant webhooks",
    "license": "MIT",
    "homepage": "https://github.com/Navruzbek05/n8n-nodes-payme",
    "keywords": [
        "n8n-community-node-package",
        "payme",
        "payments",
        "uzbekistan"
    ],
    "author": {
        "name": "Navruzbek05",
        "email": "kemalkonroy@gmail.com"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/Navruzbek05/n8n-nodes-payme.git"
    },
   "scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"test": "node --test \"test/*.test.ts\"",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
    "files": [
        "dist",
        "!dist/tsconfig.tsbuildinfo"
    ],
    "n8n": {
        "n8nNodesApiVersion": 1,
        "strict": true,
        "credentials": [
            "dist/credentials/PaymeApi.credentials.js"
        ],
        "nodes": [
            "dist/nodes/Payme/Payme.node.js",
            "dist/nodes/PaymeTrigger/PaymeTrigger.node.js"
        ]
    },
    "devDependencies": {
        "@n8n/node-cli": "*",
        "eslint": "9.32.0",
        "prettier": "3.6.2",
        "release-it": "^21.1.0",
        "typescript": "5.9.2"
    },
    "peerDependencies": {
        "n8n-workflow": "*"
    }
}
